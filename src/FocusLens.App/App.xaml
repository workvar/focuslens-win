<Application x:Class="FocusLens.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FocusLens.App.Converters"
             xmlns:vm="clr-namespace:FocusLens.App.ViewModels"
             xmlns:dash="clr-namespace:FocusLens.App.ViewModels.Dashboard"
             xmlns:chat="clr-namespace:FocusLens.App.ViewModels.Chat"
             xmlns:meet="clr-namespace:FocusLens.App.ViewModels.Meetings"
             xmlns:set="clr-namespace:FocusLens.App.ViewModels.Settings"
             xmlns:views="clr-namespace:FocusLens.App.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Light.xaml" />
                <ResourceDictionary Source="Themes/Brushes.xaml" />
                <ResourceDictionary Source="Themes/Text.xaml" />
                <ResourceDictionary Source="Themes/Cards.xaml" />
                <ResourceDictionary Source="Themes/Buttons.xaml" />
                <ResourceDictionary Source="Themes/Inputs.xaml" />
                <ResourceDictionary Source="Themes/ComboBoxes.xaml" />
                <ResourceDictionary Source="Themes/Toggles.xaml" />
                <ResourceDictionary Source="Themes/Lists.xaml" />
                <ResourceDictionary Source="Themes/Sliders.xaml" />
                <ResourceDictionary Source="Themes/Status.xaml" />
                <ResourceDictionary Source="Themes/Progress.xaml" />
                <ResourceDictionary Source="Themes/Menus.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
            <conv:FractionToStarConverter x:Key="FractionToStar" />
            <conv:FractionToStarConverter x:Key="RemainderToStar" Remainder="True" />
            <conv:EqualsConverter x:Key="Equals" />
            <conv:PercentConverter x:Key="Percent" />
            <conv:PauseLabelConverter x:Key="PauseLabel" />
            <conv:NextLabelConverter x:Key="NextLabel" />
            <conv:NotNullToVisibilityConverter x:Key="InvertedNullToVisibility" Invert="True" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:NotConverter x:Key="NotConverter" />

            <!-- View models map to views through implicit data templates. -->
            <DataTemplate DataType="{x:Type dash:DashboardViewModel}"><views:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type chat:ChatViewModel}"><views:ChatView /></DataTemplate>
            <DataTemplate DataType="{x:Type meet:MeetingsViewModel}"><views:MeetingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type set:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
