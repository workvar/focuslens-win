<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Traffic-light dot for a ServiceStatusItem. Colors come from the theme, so it follows light and dark. -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connected">
                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Degraded">
                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Disconnected">
                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar, expanded: dot and name, the detail is in the tooltip. -->
    <DataTemplate x:Key="StatusRowCompact">
        <StackPanel Orientation="Horizontal" Margin="0,3" Background="Transparent" ToolTip="{Binding Tooltip}">
            <Ellipse Style="{StaticResource StatusDot}" />
            <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>
    </DataTemplate>

    <!-- Sidebar, collapsed: dots only. -->
    <DataTemplate x:Key="StatusDotOnly">
        <Ellipse Style="{StaticResource StatusDot}" Margin="0,6" HorizontalAlignment="Center" ToolTip="{Binding Tooltip}" />
    </DataTemplate>

    <!-- Settings: dot, name and the full explanation. -->
    <DataTemplate x:Key="StatusRowDetailed">
        <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Style="{StaticResource StatusDot}" Margin="0,5,12,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
