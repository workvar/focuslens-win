<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Forest theme, light. Values mirror Mac/Sources/FocusLensApp/Views/Design/FocusPalette.swift. -->
    <Color x:Key="WindowColor">#FAFAF9</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F5F5F4</Color>
    <Color x:Key="BorderColor">#E7E5E4</Color>
    <Color x:Key="TextColor">#1C1917</Color>
    <Color x:Key="TextMutedColor">#57534E</Color>
    <Color x:Key="AccentColor">#1A5D38</Color>
    <Color x:Key="AccentHoverColor">#154A2D</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="AccentSoftColor">#E7F1EA</Color>
    <Color x:Key="DangerColor">#B91C1C</Color>
    <Color x:Key="SuccessColor">#2E7D4F</Color>
    <Color x:Key="WarningColor">#B45309</Color>
</ResourceDictionary>
