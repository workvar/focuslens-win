<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Forest theme, dark. Values mirror Mac/Sources/FocusLensApp/Views/Design/FocusPalette.swift. -->
    <Color x:Key="WindowColor">#0E1410</Color>
    <Color x:Key="SurfaceColor">#151E18</Color>
    <Color x:Key="SurfaceAltColor">#1C2822</Color>
    <Color x:Key="BorderColor">#2A382F</Color>
    <Color x:Key="TextColor">#F3F6F4</Color>
    <Color x:Key="TextMutedColor">#9DB0A4</Color>
    <Color x:Key="AccentColor">#3FA36C</Color>
    <Color x:Key="AccentHoverColor">#4DB97D</Color>
    <Color x:Key="AccentTextColor">#06140C</Color>
    <Color x:Key="AccentSoftColor">#1E3A2B</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="SuccessColor">#5FCB8E</Color>
    <Color x:Key="WarningColor">#F5B04C</Color>
</ResourceDictionary>
