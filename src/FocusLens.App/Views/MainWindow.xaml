<Window x:Class="FocusLens.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FocusLens.App.ViewModels"
        xmlns:views="clr-namespace:FocusLens.App.Views"
        Title="FocusLens" Icon="pack://application:,,,/Assets/focuslens.ico" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        Background="{DynamicResource WindowBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RowRadius}" Padding="{TemplateBinding Padding}"
                                BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarWidth" TargetType="Border">
            <Setter Property="Width" Value="248" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="Width" Value="64" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PinButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="ToolTip" Value="Pin chat" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="ToolTip" Value="Unpin chat" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ChatRowTemplate">
            <Grid Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="4,6"
                           Visibility="{Binding IsEditing, Converter={StaticResource InvertedBoolToVisibility}}" />
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="4,2"
                         LostFocus="OnConversationRenameLostFocus" KeyDown="OnConversationRenameKeyDown"
                         IsVisibleChanged="OnConversationRenameIsVisibleChanged"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Rename"
                                  Icon="&#xE70F;"
                                  Command="{Binding PlacementTarget.Tag.BeginRenameConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Command="{Binding PlacementTarget.Tag.TogglePinConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="Pin" />
                                    <Setter Property="Icon" Value="&#xE718;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsPinned, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                            <Setter Property="Header" Value="Unpin" />
                                            <Setter Property="Icon" Value="&#xE77A;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Delete"
                                  Icon="&#xE74D;"
                                  Style="{StaticResource DangerMenuItem}"
                                  Command="{Binding PlacementTarget.Tag.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Grid.InputBindings>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Main shell -->
        <Grid Visibility="{Binding IsOnboarding, Converter={StaticResource InvertedBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Style="{StaticResource SidebarWidth}" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,12" Orientation="Horizontal">
                        <Button Content="&#xE700;" FontFamily="Segoe MDL2 Assets" Command="{Binding ToggleSidebarCommand}"
                                Style="{StaticResource NavButton}" ToolTip="Collapse or expand" AutomationProperties.Name="Collapse or expand sidebar" Width="40" />
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="26" Height="26" Margin="6,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="FocusLens logo" />
                        <TextBlock Text="FocusLens" Style="{StaticResource Wordmark}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibility}}" />
                    </StackPanel>

                    <!-- Bottom: theme switch, service status, pause -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Style="{StaticResource NavButton}" Command="{Binding Settings.Appearance.ToggleLightDarkCommand}"
                                ToolTip="{Binding Settings.Appearance.ToggleLabel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Settings.Appearance.ToggleGlyph}" FontFamily="Segoe MDL2 Assets" Width="24" />
                                <TextBlock Text="{Binding Settings.Appearance.ToggleLabel}" Margin="8,0,0,0"
                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertedBoolToVisibility}}" />
                            </StackPanel>
                        </Button>

                        <!-- Collapsed sidebar: one dot per service, details in tooltips. -->
                        <ItemsControl ItemsSource="{Binding Status.Items}" ItemTemplate="{StaticResource StatusDotOnly}" Margin="0,8,0,0"
                                      Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}}" />

                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,8,0,0"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibility}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Status.Items}" ItemTemplate="{StaticResource StatusRowCompact}" />
                                <Button Content="{Binding IsPaused, Converter={StaticResource PauseLabel}}" Margin="0,8,0,0"
                                        Command="{Binding TogglePauseCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top">
                        <Button Style="{StaticResource NavButton}" Tag="{Binding IsDashboardActive}"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Dashboard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Width="24" />
                                <TextBlock Text="Dashboard" Margin="8,0,0,0" Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertedBoolToVisibility}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Tag="{Binding IsFocusActive}"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Focus}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Width="24" />
                                <TextBlock Text="Focus" Margin="8,0,0,0" Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertedBoolToVisibility}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Tag="{Binding IsChatActive}"
                                Command="{Binding NewChatCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" Width="24" />
                                <TextBlock Text="New chat" Margin="8,0,0,0" Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertedBoolToVisibility}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Tag="{Binding IsMeetingsActive}"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Meetings}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Width="24" />
                                <TextBlock Text="Meetings" Margin="8,0,0,0" Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertedBoolToVisibility}}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Tag="{Binding IsSettingsActive}"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Settings}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="24" />
                                <TextBlock Text="Settings" Margin="8,0,0,0" Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertedBoolToVisibility}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InvertedBoolToVisibility}}">
                        <TextBlock Text="Pinned chats" Style="{StaticResource Muted}" Margin="12,4,0,6" FontSize="12"
                                   Visibility="{Binding PinnedConversations.Count, Converter={StaticResource CountToVisibility}}" />
                        <ListBox ItemsSource="{Binding PinnedConversations}" SelectedItem="{Binding SelectedConversation, Mode=OneWay}"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding PinnedConversations.Count, Converter={StaticResource CountToVisibility}}"
                                 ItemTemplate="{StaticResource ChatRowTemplate}" />
                        <Grid Margin="12,16,0,6">
                            <TextBlock Text="Recent chats" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                            <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Right" Padding="4" AutomationProperties.Name="New chat"
                                    Command="{Binding NewChatCommand}">
                                <Button.ToolTip>
                                    <ToolTip Content="New chat" />
                                </Button.ToolTip>
                            </Button>
                        </Grid>
                        <ListBox ItemsSource="{Binding RecentConversations}" SelectedItem="{Binding SelectedConversation, Mode=OneWay}"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource ChatRowTemplate}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <views:MeetingBanner Grid.Row="0" DataContext="{Binding Banner}"
                                     Visibility="{Binding DataContext.ShowBanner, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Row="1">
                    <Border Background="{DynamicResource SurfaceAltBrush}" Padding="16,8"
                            Visibility="{Binding RestrictionNotice, Converter={StaticResource NotNullToVisibility}}">
                        <TextBlock Text="{Binding RestrictionNotice}" Style="{StaticResource Muted}" />
                    </Border>
                    <!-- Asks once to set up local AI and search; the install itself always waits for a confirmation. -->
                    <Border Background="{DynamicResource AccentSoftBrush}" Padding="16,10"
                            Visibility="{Binding ShowSetupNotice, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="Ollama or Chroma DB is not set up on this PC. FocusLens can download and install them for you." />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="Set up" Style="{StaticResource PrimaryButton}" Command="{Binding OpenSetupCommand}" />
                                <Button Content="Not now" Margin="8,0,0,0" Command="{Binding DismissSetupCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>

        <!-- First-run onboarding -->
        <views:OnboardingView DataContext="{Binding Onboarding}"
                              Visibility="{Binding DataContext.IsOnboarding, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Window>
