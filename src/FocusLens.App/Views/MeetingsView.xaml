<UserControl x:Class="FocusLens.App.Views.MeetingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusLens.App.Views">
    <Grid>
        <!-- List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Detail, Converter={StaticResource InvertedNullToVisibility}}">
            <StackPanel Margin="28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Meetings" Style="{StaticResource Title}" />
                    <Button Grid.Column="1" Content="Take notes now" Style="{StaticResource PrimaryButton}" Command="{Binding StartNowCommand}" />
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="No meetings yet" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="FocusLens watches for calls in Zoom, Teams, Google Meet and other apps, and offers to take notes. You can also start notes yourself." />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Meetings}" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                                        <TextBlock Style="{StaticResource Muted}">
                                            <Run Text="{Binding Provider, Mode=OneWay}" /> <Run Text=" | " /> <Run Text="{Binding When, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Duration}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Phase}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Open action items" Style="{StaticResource Heading}" Margin="0,24,0,8"
                           Visibility="{Binding OpenActions.Count, Converter={StaticResource CountToVisibility}}" />
                <ItemsControl ItemsSource="{Binding OpenActions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Item.Text}" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                        <Run Text="{Binding Item.Owner, Mode=OneWay}" /> <Run Text=" from " /> <Run Text="{Binding MeetingTitle, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Detail -->
        <views:MeetingDetailView DataContext="{Binding Detail}"
                                 Visibility="{Binding DataContext.Detail, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NotNullToVisibility}}" />
    </Grid>
</UserControl>
