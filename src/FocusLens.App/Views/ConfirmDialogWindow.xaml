<Window x:Class="FocusLens.App.Views.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        Background="{DynamicResource PopupBrush}" FontFamily="{StaticResource BodyFont}"
        AutomationProperties.Name="Confirmation">
    <StackPanel Margin="24,22,24,20">
        <TextBlock x:Name="TitleText" Style="{StaticResource Heading}" FontSize="17" />
        <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" MinWidth="88" Click="OnCancel" />
            <Button x:Name="ConfirmButton" Margin="10,0,0,0" MinWidth="88" Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
