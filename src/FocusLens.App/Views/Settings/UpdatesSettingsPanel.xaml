<UserControl x:Class="FocusLens.App.Views.Settings.UpdatesSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:FocusLens.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Updates" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{Binding CurrentVersion, StringFormat='Installed version {0}'}" />
                    <TextBlock Text="{Binding Headline}" Margin="0,12,0,0" TextWrapping="Wrap" />

                    <ProgressBar Minimum="0" Maximum="100" Height="6" Margin="0,10,0,0"
                                 Value="{Binding State.Progress, Mode=OneWay}"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding State.Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" Margin="0,14,0,0">
                        <TextBlock Text="What's new" Style="{StaticResource Eyebrow}" />
                        <ctl:MarkdownText Markdown="{Binding State.Notes}" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Check for updates" Command="{Binding CheckCommand}"
                                Visibility="{Binding ShowCheck, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Download update" Command="{Binding DownloadCommand}" Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding ShowDownload, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Restart and update" Command="{Binding RestartCommand}" Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding ShowRestart, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
