<UserControl x:Class="FocusLens.App.Views.Settings.StatusSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="System status" Style="{StaticResource Heading}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Check again" Command="{Binding RecheckCommand}"
                                IsEnabled="{Binding IsRefreshing, Converter={StaticResource NotConverter}}" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource StatusRowDetailed}" Margin="0,10,0,0" />

                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"
                               Text="Checks run every few seconds. Chroma DB and cloud models are checked less often because they are slower." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
