<UserControl x:Class="FocusLens.App.Views.Settings.AiSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Model provider" Style="{StaticResource Heading}" />
                    <ComboBox ItemsSource="{Binding Providers}" SelectedIndex="{Binding ProviderIndex}" Width="260" HorizontalAlignment="Left" Margin="0,10,0,0" />

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsOllama, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Ollama host" Style="{StaticResource Muted}" FontSize="12" />
                        <TextBox Text="{Binding OllamaHost, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,10" />
                        <TextBlock Text="Model name (for example llama3.1)" Style="{StaticResource Muted}" FontSize="12" />
                        <TextBox Text="{Binding OllamaModel, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" FontSize="12"
                                   Text="Runs entirely on this PC. Install Ollama, then run: ollama pull llama3.1" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsClaude, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Anthropic API key" Style="{StaticResource Muted}" FontSize="12" />
                        <PasswordBox x:Name="ClaudeKey" Margin="0,4,0,0" PasswordChanged="OnClaudeKeyChanged" />
                        <TextBlock Text="A key is saved (encrypted for your Windows account)." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding HasClaudeKey, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsOpenAi, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="OpenAI API key" Style="{StaticResource Muted}" FontSize="12" />
                        <PasswordBox x:Name="OpenAiKey" Margin="0,4,0,0" PasswordChanged="OnOpenAiKeyChanged" />
                        <TextBlock Text="A key is saved (encrypted for your Windows account)." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding HasOpenAiKey, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" FontSize="12"
                               Visibility="{Binding IsCloud, Converter={StaticResource BoolToVisibility}}"
                               Text="With a cloud provider, the summaries and text you allow under Data collection are sent to that provider when you ask a question." />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Test connection" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource NotConverter}}" />
                        <TextBlock Text="{Binding TestResult}" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
