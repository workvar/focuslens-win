<UserControl x:Class="FocusLens.App.Views.Settings.AiSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:FocusLens.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Model provider" Style="{StaticResource Heading}" />
                    <ComboBox ItemsSource="{Binding Providers}" SelectedIndex="{Binding ProviderIndex}" Width="280" HorizontalAlignment="Left" Margin="0,10,0,0" />

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsOllama, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Ollama host" Style="{StaticResource Muted}" FontSize="12" />
                        <TextBox Text="{Binding OllamaHost, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,10" />
                        <TextBlock Text="Model (type to search installed models)" Style="{StaticResource Muted}" FontSize="12" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ctl:SearchableComboBox ItemsSource="{Binding AvailableModels}"
                                                    Text="{Binding OllamaModel, UpdateSourceTrigger=LostFocus}"
                                                    AutomationProperties.Name="Ollama model, type to search" />
                            <Button Grid.Column="1" Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshModelsCommand}"
                                    IsEnabled="{Binding IsLoadingModels, Converter={StaticResource NotConverter}}" />
                        </Grid>
                        <TextBlock Text="{Binding ModelsHint}" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"
                                   Text="Runs entirely on this PC. To add a model, use Settings > Local tools, or run: ollama pull llama3.1" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsClaude, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Anthropic API key" Style="{StaticResource Muted}" FontSize="12" />
                        <PasswordBox x:Name="ClaudeKey" Margin="0,4,0,0" PasswordChanged="OnClaudeKeyChanged" />
                        <TextBlock Text="A key is saved (encrypted for your Windows account)." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding HasClaudeKey, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsOpenAi, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="OpenAI API key" Style="{StaticResource Muted}" FontSize="12" />
                        <PasswordBox x:Name="OpenAiKey" Margin="0,4,0,0" PasswordChanged="OnOpenAiKeyChanged" />
                        <TextBlock Text="A key is saved (encrypted for your Windows account)." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding HasOpenAiKey, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsNvidia, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="NVIDIA API key" Style="{StaticResource Muted}" FontSize="12" />
                        <PasswordBox x:Name="NvidiaKey" Margin="0,4,0,0" PasswordChanged="OnNvidiaKeyChanged" />
                        <TextBlock Text="A key is saved (encrypted for your Windows account)." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding HasNvidiaKey, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsDeepSeek, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="DeepSeek API key" Style="{StaticResource Muted}" FontSize="12" />
                        <PasswordBox x:Name="DeepSeekKey" Margin="0,4,0,0" PasswordChanged="OnDeepSeekKeyChanged" />
                        <TextBlock Text="A key is saved (encrypted for your Windows account)." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding HasDeepSeekKey, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" FontSize="12"
                               Visibility="{Binding IsCloud, Converter={StaticResource BoolToVisibility}}"
                               Text="With a cloud provider, the summaries and text you allow under Data collection are sent to that provider when you ask a question." />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Test connection" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource NotConverter}}" />
                        <TextBlock Text="{Binding TestResult}" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
