<UserControl x:Class="FocusLens.App.Views.Settings.PrivacySettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                       Text="Turn a category on to exclude it: matching apps, sites and window text are never recorded. Apps are executable names such as 1password.exe; sites match subdomains too." />

            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Content="Edit list" Padding="10,4" Margin="0,0,12,0" IsChecked="{Binding IsExpanded}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" ToolTip="Exclude this category" />
                                </Grid>
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Apps (one per line)" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBox Text="{Binding AppsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="54" Margin="0,4,0,8" />
                                    <TextBlock Text="Sites (one per line)" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBox Text="{Binding DomainsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="54" Margin="0,4,0,8" />
                                    <TextBlock Text="Keywords in titles, URLs and on-screen text (one per line)" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBox Text="{Binding KeywordsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="54" Margin="0,4,0,0" />
                                    <Button Content="Remove category" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Command="{Binding DataContext.RemoveCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="Add category" Command="{Binding AddCategoryCommand}" Margin="8,0,0,0" />
            </Grid>
            <Button Content="Reset to defaults" Command="{Binding ResetDefaultsCommand}" HorizontalAlignment="Left" Margin="0,12,0,24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
