<UserControl x:Class="FocusLens.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:FocusLens.App.Controls">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Empty state -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Ask about your time" Style="{StaticResource Title}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,20"
                       Text="Answers use only the activity FocusLens has recorded on this PC." />
            <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Margin="0,4" HorizontalContentAlignment="Left"
                                Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Transcript -->
        <ScrollViewer x:Name="Scroller" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InvertedBoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Messages}" Margin="28,20" MaxWidth="820">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,8">
                            <!-- User -->
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="14" Padding="14,10" HorizontalAlignment="Right" MaxWidth="560"
                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Content}" Foreground="{DynamicResource AccentTextBrush}" />
                            </Border>
                            <!-- Assistant -->
                            <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MaxWidth="700"
                                    Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <ctl:MarkdownText Markdown="{Binding Content}" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="Thinking..." Style="{StaticResource Muted}"
                                               Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <!-- Error -->
                            <Border BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" HorizontalAlignment="Left" MaxWidth="700"
                                    Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Content}" Foreground="{DynamicResource DangerBrush}" />
                            </Border>
                            <!-- Chart -->
                            <Border Style="{StaticResource Card}" HorizontalAlignment="Left" Width="640"
                                    Visibility="{Binding IsChart, Converter={StaticResource BoolToVisibility}}">
                                <ctl:ChartCanvas Payload="{Binding Chart}" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Composer -->
        <Border Grid.Row="1" Padding="28,12,28,20" Background="{DynamicResource WindowBrush}">
            <Grid MaxWidth="820">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Input" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False"
                         VerticalContentAlignment="Center" MinHeight="42" FontSize="14" KeyDown="OnInputKeyDown" />
                <Button Grid.Column="1" Content="Send" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="72"
                        Command="{Binding SendCommand}"
                        Visibility="{Binding IsStreaming, Converter={StaticResource InvertedBoolToVisibility}}" />
                <Button Grid.Column="1" Content="Stop" Margin="8,0,0,0" MinWidth="72"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
