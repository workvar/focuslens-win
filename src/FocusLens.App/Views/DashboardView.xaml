<UserControl x:Class="FocusLens.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:FocusLens.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DateLabel}" Style="{StaticResource Title}" />
                    <TextBlock Text="{Binding FocusLabel}" Style="{StaticResource Muted}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Command="{Binding PreviousDayCommand}" ToolTip="Previous day" />
                    <Button Content="Today" Command="{Binding GoToTodayCommand}" Margin="6,0" />
                    <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Command="{Binding NextDayCommand}" ToolTip="Next day" />
                    <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Command="{Binding LoadCommand}" Margin="6,0,0,0" ToolTip="Refresh" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVisibility}}" />

            <Border Style="{StaticResource Card}" Margin="0,20,0,0"
                    Visibility="{Binding HasData, Converter={StaticResource InvertedBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="No activity recorded for this day" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Text="Make sure the FocusLens agent is running (see the status at the bottom of the sidebar). Data appears here within a few seconds of tracking starting." />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <!-- Focus score + stat cards -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Focus score" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding FocusScoreText}" FontSize="52" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding DeltaText}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Stats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Categories + top apps -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,12,6,0">
                        <StackPanel>
                            <TextBlock Text="Where your time went" Style="{StaticResource Heading}" />
                            <ctl:ChartCanvas Payload="{Binding CategoryChart}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Top apps" Style="{StaticResource Heading}" />
                            <ItemsControl ItemsSource="{Binding TopApps}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,4,0,0" Height="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionToStar}}" />
                                                    <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource RemainderToStar}}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Hourly rhythm -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Your day by hour" Style="{StaticResource Heading}" />
                        <ItemsControl ItemsSource="{Binding Hours}" Margin="0,12,0,0" Height="136">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,0" ToolTip="{Binding Tooltip}">
                                        <Border Height="110" VerticalAlignment="Bottom">
                                            <ItemsControl ItemsSource="{Binding Segments}" VerticalAlignment="Bottom">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Height="{Binding Height}" Background="{Binding Color}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Trend -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                        Visibility="{Binding TrendChart, Converter={StaticResource NotNullToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Focus score, last 7 days" Style="{StaticResource Heading}" />
                        <ctl:ChartCanvas Payload="{Binding TrendChart}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
