<UserControl x:Class="FocusLens.App.Views.RecordingControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Meeting recorder card. Bound to MeetingBannerViewModel, so the Meetings page and the top strip stay in step. -->
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="12" Height="12" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <StackPanel>
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Heading}" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding PhaseText}" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding ElapsedText}" Margin="10,0,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Progress, Converter={StaticResource Percent}}" Margin="10,0,0,0"
                                   Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Record" Style="{StaticResource PrimaryButton}" Command="{Binding RecordNewCommand}"
                        AutomationProperties.Name="Start recording a meeting"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Record this meeting" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                        Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Not now" Command="{Binding DismissCommand}" Margin="8,0,0,0"
                        Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Pause" Command="{Binding PauseCommand}" AutomationProperties.Name="Pause recording"
                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Resume" Style="{StaticResource PrimaryButton}" Command="{Binding ResumeCommand}" AutomationProperties.Name="Resume recording"
                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Stop" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" Margin="8,0,0,0"
                        AutomationProperties.Name="Stop recording and create notes"
                        Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Dismiss" Command="{Binding AcknowledgeCommand}"
                        Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
