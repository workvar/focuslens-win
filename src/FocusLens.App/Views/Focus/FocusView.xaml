<UserControl x:Class="FocusLens.App.Views.Focus.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:focus="clr-namespace:FocusLens.App.Views.Focus"
             xmlns:fc="clr-namespace:FocusLens.App.Controls.Focus">
    <!-- The Focus tab: set a goal, a length and what happens when you drift; watch the clock; look back at past sessions. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Detail, Converter={StaticResource InvertedNullToVisibility}}">
            <StackPanel Margin="28,24" MaxWidth="680">
                <TextBlock Text="Focus mode" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,20"
                           Text="Tell FocusLens what you are working on. When you drift, a patience bar starts to drain. Halfway, you get a nudge. When it is empty, the tab or window is closed or blocked, your choice." />

                <focus:FocusActiveCard Visibility="{Binding Live.IsActive, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Visibility="{Binding Live.IsActive, Converter={StaticResource InvertedBoolToVisibility}}">
                    <focus:FocusSetupCard />

                    <!-- The session that just ended, with a way into its insights. -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" DataContext="{Binding LastSession}"
                            Visibility="{Binding DataContext.LastSession, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NotNullToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <fc:ScoreRing Score="{Binding Score}" Width="64" Height="64" Thickness="7" />
                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SummaryTitle}" Style="{StaticResource Heading}" />
                                <TextBlock Text="{Binding Goal}" />
                                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource FocusCaption}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="View insights" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <focus:FocusSessionsList Margin="0,16,0,0" />

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Show my session" Style="{StaticResource FocusSectionLabel}" />
                        <focus:FocusDisplayToggles DataContext="{Binding Settings}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Keep it light" Style="{StaticResource FocusSectionLabel}" />
                        <focus:FocusPerformanceControls DataContext="{Binding Settings}" ShowsModel="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <focus:FocusSessionDetailView DataContext="{Binding Detail}"
                                      Visibility="{Binding DataContext.Detail, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NotNullToVisibility}}" />
    </Grid>
</UserControl>
