<UserControl x:Class="FocusLens.App.Views.Focus.FocusActiveCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fc="clr-namespace:FocusLens.App.Controls.Focus">
    <!-- Shown while a session is running: the goal, the clock, the live score and the patience bar. -->
    <Border Style="{StaticResource Card}" Padding="24">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Focusing on" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Live.Goal}" FontFamily="{StaticResource HeadingFont}" FontSize="26" TextAlignment="Center" Margin="0,4,0,16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Live.RemainingText}" FontSize="52" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="left" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="28,0,0,0" VerticalAlignment="Center">
                    <fc:ScoreRing Score="{Binding Live.Score}" Width="84" Height="84" Thickness="8" />
                    <TextBlock Text="Focus score" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <fc:MeterBar Level="{Binding Live.MeterLevel}" Height="10" Width="360" Margin="0,16,0,6" />
            <TextBlock Text="{Binding Live.MeterCaption}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" />

            <Button Content="End session" Command="{Binding StopCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
    </Border>
</UserControl>
