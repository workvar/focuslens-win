<UserControl x:Class="FocusLens.App.Views.Focus.FocusSetupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Three questions: what to focus on, for how long, and what should happen when you drift. -->
    <Border Style="{StaticResource Card}" Padding="20">
        <StackPanel>
            <TextBlock Text="What do you want to focus on?" FontFamily="{StaticResource HeadingFont}" FontSize="20" Margin="0,0,0,8" />
            <Grid>
                <TextBox x:Name="GoalBox" Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Focus goal">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding StartCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="For example: study .NET" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding Goal, Converter={StaticResource InvertedNullToVisibility}}" />
            </Grid>

            <TextBlock Text="For how long?" Style="{StaticResource FocusSectionLabel}" Margin="0,20,0,8" />
            <ItemsControl ItemsSource="{Binding Durations}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Style="{StaticResource FocusChip}" Tag="{Binding IsSelected}"
                                Command="{Binding DataContext.SelectDurationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="When you drift" Style="{StaticResource FocusSectionLabel}" Margin="0,12,0,8" />
            <ItemsControl ItemsSource="{Binding Enforcements}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource FocusOptionCard}" Tag="{Binding IsSelected}" Margin="0,0,10,0"
                                AutomationProperties.Name="{Binding Title}"
                                Command="{Binding DataContext.SelectEnforcementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource FocusCaption}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Margin="0,20,0,0" Padding="16,10"
                    HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                    <TextBlock Text="Start focus" Margin="8,0,0,0" Foreground="{DynamicResource AccentTextBrush}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
