<UserControl x:Class="FocusLens.App.Views.Focus.FocusSessionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fc="clr-namespace:FocusLens.App.Controls.Focus">
    <!-- Insights for one saved session: score, time split, the score over time, what pulled you away, and every distraction in order. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="760">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <fc:ScoreRing Score="{Binding Score}" Width="84" Height="84" Thickness="9" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="16,0">
                    <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="Focus" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Goal}" FontFamily="{StaticResource HeadingFont}" FontSize="26" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource FocusCaption}" />
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                        ToolTip="Delete this session" AutomationProperties.Name="Delete this session" Command="{Binding DeleteCommand}" />
            </Grid>

            <!-- Tiles -->
            <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,18,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" TextWrapping="NoWrap"
                                           Foreground="{Binding Tone, Converter={StaticResource FocusTone}, ConverterParameter=text}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Insights" Style="{StaticResource FocusSectionLabel}" />
                    <ItemsControl ItemsSource="{Binding Insights}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,8" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Focus score over time" Style="{StaticResource FocusSectionLabel}" />
                    <fc:FocusScoreChart Record="{Binding Record}" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasEpisodes, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="What pulled you away" Style="{StaticResource FocusSectionLabel}" />
                        <ItemsControl ItemsSource="{Binding Breakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                                        </Grid>
                                        <fc:MeterBar Level="{Binding Fraction}" Fill="{DynamicResource WarningBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Every distraction" Style="{StaticResource FocusSectionLabel}" />
                        <ItemsControl ItemsSource="{Binding Episodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Clock}" Style="{StaticResource Muted}" FontSize="12" />
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Label}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                           Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Duration}" HorizontalAlignment="Right" />
                                                <Border CornerRadius="{DynamicResource PillRadius}" Padding="8,2" Margin="0,4,0,0" HorizontalAlignment="Right"
                                                        Background="{Binding Tone, Converter={StaticResource FocusToneSoft}}">
                                                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Tone, Converter={StaticResource FocusTone}}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
