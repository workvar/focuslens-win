<Window x:Class="FocusLens.App.Views.Focus.FocusWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fc="clr-namespace:FocusLens.App.Controls.Focus"
        Title="FocusLens focus" Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        FontFamily="{StaticResource BodyFont}">
    <!-- The persistent floating widget: live score, goal, time left and the patience bar. When you drift, a drawer
         of the same width extends its bottom edge with the nudge or the countdown, so there is one window to watch.
         The window grows downward (SizeToContent keeps the top edge), so the top stays where the user put it. -->
    <Border x:Name="Card" Margin="10" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource SurfaceBrush}"
            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" MouseLeftButtonDown="OnDrag">
        <StackPanel>
            <!-- Pill -->
            <Grid Height="96" Margin="16,0" Visibility="{Binding ShowsPill, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <fc:ScoreRing Score="{Binding Live.Score}" Width="60" Height="60" Thickness="6" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Live.Goal}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Live.RemainingText}" Style="{StaticResource Muted}" Margin="6,0,0,0" />
                    </StackPanel>
                    <fc:MeterBar Level="{Binding Live.MeterLevel}" Height="8" />
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE71A;" Style="{StaticResource IconButton}" FontSize="11" VerticalAlignment="Center"
                        ToolTip="End focus session" AutomationProperties.Name="End focus session" Command="{Binding StopCommand}" />
            </Grid>

            <!-- Drawer: the patience bar draining, the halfway nudge, the countdown, and short results. -->
            <Border DataContext="{Binding Drawer}" Height="68" Padding="14,8"
                    CornerRadius="{DynamicResource CardRadius}"
                    Background="{Binding Tone, Converter={StaticResource FocusToneSoft}}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Visibility="{Binding DataContext.ShowsDrawer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="34" Height="34" VerticalAlignment="Center">
                        <Ellipse Stroke="{Binding Tone, Converter={StaticResource FocusTone}}" StrokeThickness="3"
                                 Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Countdown}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding Tone, Converter={StaticResource FocusTone}}"
                                   Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding Tone, Converter={StaticResource FocusTone}}"
                                   Visibility="{Binding HasCountdown, Converter={StaticResource InvertedBoolToVisibility}}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,40,0" />
                            <TextBlock Text="{Binding Caption}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"
                                       Foreground="{Binding Tone, Converter={StaticResource FocusTone}}" />
                        </Grid>
                        <fc:MeterBar Level="{Binding Level}" Height="7" Margin="0,4"
                                     Visibility="{Binding HasLevel, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Stay 5 min" Style="{StaticResource PrimaryButton}" Padding="10,4" VerticalAlignment="Center"
                            Command="{Binding DataContext.SnoozeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding ShowsSnooze, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
