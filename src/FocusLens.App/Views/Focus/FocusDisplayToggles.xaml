<UserControl x:Class="FocusLens.App.Views.Focus.FocusDisplayToggles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Where the session shows up. Used on the Focus page and in Settings, bound to the same settings. -->
    <StackPanel>
        <CheckBox Content="Floating widget (drag it anywhere)" IsChecked="{Binding ShowWidget}" />
        <CheckBox Content="Time left in the tray icon" IsChecked="{Binding ShowTrayTimer}" Margin="0,8,0,0" />
        <TextBlock Style="{StaticResource FocusCaption}" Margin="0,8,0,0"
                   Text="Nudges and the closing countdown always appear, under the widget or on their own if the widget is off." />
    </StackPanel>
</UserControl>
