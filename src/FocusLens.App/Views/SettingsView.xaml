<UserControl x:Class="FocusLens.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FocusLens.App.Views.Settings">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Settings" Style="{StaticResource Title}" Margin="0,0,0,16" />

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0,16,0,0">
            <TabItem Header="General">
                <views:GeneralSettingsPanel DataContext="{Binding General}" />
            </TabItem>
            <TabItem Header="Appearance">
                <views:AppearanceSettingsPanel DataContext="{Binding Appearance}" />
            </TabItem>
            <TabItem Header="Data collection">
                <views:TrackingSettingsPanel DataContext="{Binding Tracking}" />
            </TabItem>
            <TabItem Header="Focus">
                <views:FocusSettingsPanel DataContext="{Binding Focus}" />
            </TabItem>
            <TabItem Header="Privacy">
                <views:PrivacySettingsPanel DataContext="{Binding Privacy}" />
            </TabItem>
            <TabItem Header="AI">
                <views:AiSettingsPanel DataContext="{Binding Ai}" />
            </TabItem>
            <TabItem Header="Meetings">
                <views:MeetingSettingsPanel DataContext="{Binding Meetings}" />
            </TabItem>
            <TabItem Header="Status">
                <views:StatusSettingsPanel DataContext="{Binding Status}" />
            </TabItem>
            <TabItem Header="Permissions">
                <views:PermissionsSettingsPanel DataContext="{Binding Permissions}" />
            </TabItem>
            <TabItem Header="Local tools">
                <views:LocalToolsSettingsPanel DataContext="{Binding LocalTools}" />
            </TabItem>
            <TabItem Header="Memory">
                <views:ChromaSettingsPanel DataContext="{Binding Memory}" />
            </TabItem>
            <TabItem Header="Updates">
                <views:UpdatesSettingsPanel DataContext="{Binding Updates}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
