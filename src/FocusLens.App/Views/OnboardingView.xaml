<UserControl x:Class="FocusLens.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBrush}">
        <Border Style="{StaticResource Card}" Width="520" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <!-- Step 1 -->
                <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Left" Margin="0,0,0,14"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="FocusLens logo" />
                    <TextBlock Text="Welcome to FocusLens" Style="{StaticResource Title}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Text="FocusLens notices which apps and sites you use, understands what you are working on, and helps you stay on track. Everything is stored on this PC." />
                    <TextBlock Margin="0,16,0,0" Text="Each kind of data has its own switch in Settings, and you can pause tracking at any time from the tray icon." />
                </StackPanel>

                <!-- Step 2 -->
                <StackPanel Visibility="{Binding IsPrivacy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Privacy first" Style="{StaticResource Title}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Text="Banking, password managers, health, crypto and adult content are excluded by default. You can edit these categories or add your own under Settings, Privacy." />
                    <TextBlock Margin="0,16,0,0"
                               Text="Typing counts never include which keys you press. Copy activity never includes what you copied. Screenshots are never saved; only text read on this PC is kept." />
                </StackPanel>

                <!-- Step 3 -->
                <StackPanel Visibility="{Binding IsAccount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Almost there" Style="{StaticResource Title}" />
                    <CheckBox Content="Start FocusLens tracking when I sign in to Windows" IsChecked="{Binding StartWithWindows}" Margin="0,16,0,0" />
                    <StackPanel Visibility="{Binding CanSignIn, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Optional. Sign in with Google to identify your account. An Anthropic, OpenAI, NVIDIA, or DeepSeek key is entered in Settings and does not need an account. Your activity data never leaves this PC." />
                        <Button Content="Sign in with Google" Command="{Binding SignInCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding Auth.AuthError}" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0"
                                   Visibility="{Binding Auth.AuthError, Converter={StaticResource NotNullToVisibility}}" />
                        <TextBlock Text="{Binding Auth.CurrentUser.Email}" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding Auth.CurrentUser, Converter={StaticResource NotNullToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                    <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsWelcome, Converter={StaticResource InvertedBoolToVisibility}}" />
                    <Button Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}">
                        <Button.Content>
                            <TextBlock Text="{Binding IsLastStep, Converter={StaticResource NextLabel}}" Foreground="{DynamicResource AccentTextBrush}" />
                        </Button.Content>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
